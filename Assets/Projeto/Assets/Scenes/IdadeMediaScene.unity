  m_Script: {fileID: 11500000, guid: cf76be59274cbb1419a2536fc5c008c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  companionName: Sir Aldric
  companionColor: {r: 0.85, g: 0.72, b: 0.15, a: 1}
  introLine: "Salve, viajante! Sou Sir Aldric, cavaleiro guardi\xE3o deste museu.
    Permita-me gui\xE1-lo pelos tesouros da Idade M\xE9dia."
  allDoneLines: "Honroso! Voc\xEA conheceu todas as rel\xEDquias desta era. O rei
    certamente ficaria impressionado. Retorne ao museu."
  exhibitComments:
  - Este manuscrito levou meses para ser produzido. Cada letra, uma obra de arte.
  - "Este bras\xE3o pertenceu a uma fam\xEDlia nobre. Cada s\xEDmbolo conta uma batalha
    vencida."
  - "Forjada \xE0 m\xE3o, temperada em fogo e \xE1gua. Uma espada assim durava gera\xE7\xF5es."
  exhibitAudioClips: []
  introAudioClip: {fileID: 0}
  allDoneAudioClip: {fileID: 0}
  followDistance: 1.8
  followHeight: 0
  moveSpeed: 4
  rotateSpeed: 6
  side: 1
