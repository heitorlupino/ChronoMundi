--- !u!114 &331296799
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 331296797}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec6fc3da06e520d44b9710a95471c345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationClip: {fileID: 0}
  subtitleText: "Bras\xE3o de fam\xEDlia nobre \u2014 identidade e honra em metal"
  artifactName: "Escudo Her\xE1ldico"
  artifactDescription: "Os bras\xF5es her\xE1ldicos funcionavam como identidades
    visuais das fam\xEDlias nobres medievais \u2014 um sistema de reconhecimento
    visual indispens\xE1vel em tempos de batalha, quando rostos ficavam ocultos por
    capacetes de metal.\n\nCada elemento era codificado com precis\xE3o: o vermelho
    (goles) simbolizava coragem e ousadia; o dourado (ouro), nobreza e generosidade;
    o le\xE3o, for\xE7a e bravura em combate. A combina\xE7\xE3o era \xFAnica para
    cada linhagem e protegida por lei.\n\nO escudo era passado de pai para filho
    como rel\xEDquia sagrada. Perder ou manchar o bras\xE3o da fam\xEDlia era considerado
    a maior desonra que um cavaleiro poderia sofrer."
  interactOnlyOnce: 1
