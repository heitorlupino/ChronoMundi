--- !u!114 &356658784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 356658779}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec6fc3da06e520d44b9710a95471c345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationClip: {fileID: 0}
  subtitleText: "Al\xE9m dos Limites: A M\xE1quina que Redefine o Poss\xEDvel\n\nEsta
    superm\xE1quina futurista \xE9 o \xE1pice da engenharia humana, uma estrutura
    colossal de metal, energia e intelig\xEAncia que opera em dimens\xF5es f\xEDsicas
    e computacionais simultaneamente, capaz de realizar em segundos o que levaria
    s\xE9culos de trabalho humano. \n\nSeus sistemas integrados combinam rob\xF3tica
    avan\xE7ada, fus\xE3o nuclear e algoritmos qu\xE2nticos para transformar mat\xE9ria,
    energia e informa\xE7\xE3o com uma efici\xEAncia jamais vista na hist\xF3ria
    da civiliza\xE7\xE3o. Olhar para ela \xE9 contemplar o limite entre a tecnologia
    e o divino, uma cria\xE7\xE3o que levanta a quest\xE3o fundamental: at\xE9 onde
    a humanidade pode ir antes de se tornar algo completamente novo?"
  artifactName: KRONOS-7
  artifactDescription: "Esta superm\xE1quina futurista \xE9 o \xE1pice da engenharia
    humana, uma estrutura colossal de metal, energia e intelig\xEAncia que opera
    em dimens\xF5es f\xEDsicas e computacionais simultaneamente, capaz de realizar
    em segundos o que levaria s\xE9culos de trabalho humano. \n\nSeus sistemas integrados
    combinam rob\xF3tica avan\xE7ada, fus\xE3o nuclear e algoritmos qu\xE2nticos
    para transformar mat\xE9ria, energia e informa\xE7\xE3o com uma efici\xEAncia
    jamais vista na hist\xF3ria da civiliza\xE7\xE3o. Olhar para ela \xE9 contemplar
    o limite entre a tecnologia e o divino, uma cria\xE7\xE3o que levanta a quest\xE3o
    fundamental: at\xE9 onde a humanidade pode ir antes de se tornar algo completamente
    novo?"
  interactOnlyOnce: 1
