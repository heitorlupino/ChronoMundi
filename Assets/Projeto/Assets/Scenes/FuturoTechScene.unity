--- !u!114 &858940390
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 858940385}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec6fc3da06e520d44b9710a95471c345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationClip: {fileID: 0}
  subtitleText: "Mente Digital: O Computador que Enxerga o Futuro Antes de Acontecer\n\nEste
    computador futurista vai muito al\xE9m do processamento comum, sendo capaz de
    analisar padr\xF5es complexos, prever cen\xE1rios e cruzar bilh\xF5es de dados
    em fra\xE7\xF5es de segundo com uma precis\xE3o que desafia a compreens\xE3o
    humana. "
  artifactName: Super Computador
  artifactDescription: "Este computador futurista vai muito al\xE9m do processamento
    comum, sendo capaz de analisar padr\xF5es complexos, prever cen\xE1rios e cruzar
    bilh\xF5es de dados em fra\xE7\xF5es de segundo com uma precis\xE3o que desafia
    a compreens\xE3o humana. \n\nEquipado com intelig\xEAncia artificial avan\xE7ada
    e interfaces neurais, ele n\xE3o apenas processa informa\xE7\xF5es, mas aprende,
    evolui e antecipa decis\xF5es antes mesmo que o operador as formule. \xC9 a fus\xE3o
    definitiva entre tecnologia e cogni\xE7\xE3o, uma m\xE1quina que n\xE3o apenas
    responde perguntas, mas faz as perguntas que nenhum humano ainda pensou em fazer."
  interactOnlyOnce: 1
