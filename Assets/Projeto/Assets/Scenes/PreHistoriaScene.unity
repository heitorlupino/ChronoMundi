--- !u!114 &268615465
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 268615460}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec6fc3da06e520d44b9710a95471c345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationClip: {fileID: 0}
  subtitleText: "Ca\xE7adores em Bando: A Intelig\xEAncia Mortal dos Velociraptores"
  artifactName: Velociraptores
  artifactDescription: "Os velociraptores eram dinossauros carn\xEDvoros de pequeno
    porte, mas extremamente \xE1geis e inteligentes, capazes de coordenar ataques
    em grupo para abater presas muito maiores do que eles. Cobertos de penas e equipados
    com uma garra retr\xE1til afiada nos p\xE9s, eram predadores sofisticados que
    combinavam velocidade, vis\xE3o agu\xE7ada e comportamento social para dominar
    seu ambiente. \n\nViveram h\xE1 cerca de 75 milh\xF5es de anos na \xC1sia Central,
    e seu modelo de ca\xE7a em bando os tornou um dos dinossauros mais temidos e
    estudados da hist\xF3ria."
  interactOnlyOnce: 1
