--- !u!114 &651569522
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 651569520}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec6fc3da06e520d44b9710a95471c345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  narrationClip: {fileID: 0}
  subtitleText: "Cabe\xE7a de Pedra: O Mist\xE9rio por Tr\xE1s do Cr\xE2nio mais
    Duro da Pr\xE9-Hist\xF3ria\n\nO paquicefalossauro era um dinossauro herb\xEDvoro
    conhecido pelo seu cr\xE2nio extremamente espesso, que podia chegar a 25 cent\xEDmetros
    de espessura, usado provavelmente em disputas territoriais entre machos. Viveu
    no final do Cret\xE1ceo, h\xE1 cerca de 70 milh\xF5es de anos, e se locomovia
    em duas patas pelas florestas e plan\xEDcies da Am\xE9rica do Norte. \n\nApesar
    de seu aspecto intimidador, era um animal de m\xE9dio porte, e seu cr\xE2nio
    abobadado permanece at\xE9 hoje um dos tra\xE7os mais fascinantes e debatidos
    da paleontologia.\n"
  artifactName: Paquicefalossauro
  artifactDescription: "O paquicefalossauro era um dinossauro herb\xEDvoro conhecido
    pelo seu cr\xE2nio extremamente espesso, que podia chegar a 25 cent\xEDmetros
    de espessura, usado provavelmente em disputas territoriais entre machos. Viveu
    no final do Cret\xE1ceo, h\xE1 cerca de 70 milh\xF5es de anos, e se locomovia
    em duas patas pelas florestas e plan\xEDcies da Am\xE9rica do Norte. \n\nApesar
    de seu aspecto intimidador, era um animal de m\xE9dio porte, e seu cr\xE2nio
    abobadado permanece at\xE9 hoje um dos tra\xE7os mais fascinantes e debatidos
    da paleontologia."
  interactOnlyOnce: 1
